{
  "expo": {
    "name": "still",
    "slug": "still",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.allandominguez.still",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "still needs camera access to capture today's photo."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "still needs access to your photos to choose today's photo."
        }
      ],
      "expo-asset",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "still uses your location when no GPS data is in the photo."
        }
      ],
      "expo-sharing",
      "expo-status-bar"
    ]
  }
}
